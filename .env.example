# Required. Your OpenRouter API key — https://openrouter.ai/keys
# Every council run makes 10-14 billed API calls, so this key spends real money.
OPENROUTER_API_KEY=

# Optional. Port the Express backend listens on. Defaults to 3001.
# Note: the Vite dev proxy in vite.config.ts is hardcoded to http://localhost:3001,
# so if you change this you must update that proxy target too.
PORT=3001

# Optional. Path to the SQLite file sessions are persisted to.
# Defaults to model-council.sqlite in the repo root.
DB_PATH=model-council.sqlite
